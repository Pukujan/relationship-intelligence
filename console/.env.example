# Copilot server (console/server/index.ts). Copy to .env — .env is gitignored.
# The key is a Token Plan key from Alibaba Cloud Model Studio (OpenAI-compatible).
TOKEN_PLAN_API_KEY=
TOKEN_PLAN_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
COPILOT_MODEL=qwen3.6-flash
COPILOT_PORT=8799

# Octo workspace (traces/evals + owner-mode world routes use the adapter's
# principal token; the copilot server uses this key for telemetry only).
OCTO_API_URL=https://octodb.design-bakery.com
OCTO_API_KEY=
OCTO_WORKSPACE_ID=
