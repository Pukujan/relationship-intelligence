# Octo instance this app talks to.
OCTO_API_URL=https://octodb.design-bakery.com

# Origin the browser uses to reach this app (no trailing slash).
APP_ORIGIN=http://localhost:5173

# Encrypts the session cookie. Generate once per deployment:
#   openssl rand -base64 32
# Rotating it signs everyone out.
SESSION_PASSWORD=

# Adapter port (Vite proxies /app-api and /octo-auth here in dev).
PORT=8787
